{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "lint": {
      "dependsOn": ["^build"]
    },
    "format": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@unthrown/docs#build": {
      "dependsOn": [
        "unthrown#build",
        "@unthrown/vitest#build",
        "@unthrown/effect#build",
        "@unthrown/neverthrow#build",
        "@unthrown/boxed#build",
        "@unthrown/standard-schema#build",
        "@unthrown/prisma#build",
        "@unthrown/drizzle#build",
        "@unthrown/orpc#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", "../packages/*/src/**", "!superpowers/**"],
      "outputs": [".vitepress/dist/**", "api/*/**"],
      "env": ["DOCS_BASE", "DOCS_VERSIONS"]
    }
  }
}
