# Dependencies
node_modules/

# Build output
**/dist/
*.tsbuildinfo

# Test coverage
coverage/
*.lcov

# Turbo
.turbo/

# VitePress
docs/.vitepress/cache/
docs/.vitepress/dist/
# Per-package API reference, generated into the site by TypeDoc at build time
# (the hand-written docs/api/index.md overview is kept)
docs/api/*/

# Logs
*.log

# Env files
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/

# macOS
.DS_Store

# Ephemeral subagent-driven-development workspace (ledgers, briefs, review
# diffs) — deleted when a plan finishes. Distinct from `docs/superpowers/`
# (specs, plans, and other durable planning docs), which is tracked in full.
.superpowers/
