# Dependencies
node_modules/

# Build output
**/dist/
*.tsbuildinfo

# Test coverage
coverage/
*.lcov

# Turbo
.turbo/

# VitePress
docs/.vitepress/cache/
docs/.vitepress/dist/
# Per-package API reference, generated into the site by TypeDoc at build time
# (the hand-written docs/api/index.md overview is kept)
docs/api/*/

# Stale per-package TypeDoc output. TypeDoc runs from `docs/` and writes
# straight into `docs/api/<name>/` — there is no per-package `build:docs` and no
# copy step — so anything here is a leftover from the older arrangement, or a
# stray local run. Ignored so it cannot be swept into a commit again.
packages/*/docs/

# Logs
*.log

# Env files
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/

# macOS
.DS_Store

# Local brainstorming specs and implementation plans (not tracked). They live
# under `docs/`, so VitePress would otherwise build them as site pages — hence
# the `srcExclude` in `docs/.vitepress/config.ts`, which is what keeps
# `pnpm build` green whether or not these files are present.
docs/superpowers/
.superpowers/
